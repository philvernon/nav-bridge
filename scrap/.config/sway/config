# set $wsF8  18:
# set $wsF9  19:19
# set $wsF10 20:20
# set $wsF11 21:
# set $wsF12 22:

# default display outputs for workspaces
workspace $ws1 output $disp1
workspace $ws2 output $disp1
workspace $ws3 output $disp1
workspace $ws4 output $disp1
workspace $ws5 output $disp2
workspace $ws6 output $disp2
workspace $ws7 output $disp2
workspace $ws8 output $disp2
workspace $ws9 output $disp3
# workspace 9 output $disp2
workspace $ws0 output $disp2

# exec_always swaymsg "workspace $ws1; exec foot"
# exec_always swaymsg "workspace $ws5; exec firefox"

assign [app_id="^spotify$"] $ws0
assign [title="^Steam$"] $ws9
assign [title="^Steam Big Picture Mode$"] $ws9

